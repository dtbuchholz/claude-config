{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "allow": [
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm test:*)",
      "Bash(pnpm build)",
      "Bash(pnpm start)",
      "Bash(pnpm vitest)",
      "Bash(pnpm install)",
      "Bash(pnpm run dev)",
      "Bash(pnpm dev)",
      "Read(~/.zshrc)",
      "Read(~/.bashrc)",
      "Read(~/.bash_profile)",
      "Read(~/.profile)",
      "Read(~/.config/fish/config.fish)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(jq:*)",
      "Bash(grep:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(wc:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(tee:*)",
      "Bash(tree:*)",
      "Bash(cat:*)",
      "Bash(gh pr view)",
      "Bash(gh pr create)",
      "Bash(gh api)",
      "Bash(git status)",
      "Bash(git commit)",
      "Bash(git log)",
      "Bash(git diff)",
      "Bash(git add)",
      "Bash(git push)",
      "Bash(git pull)",
      "Bash(git fetch)",
      "Bash(git merge)",
      "Bash(git rebase)",
      "Bash(git reset)",
      "Bash(git revert)",
      "Bash(git cherry-pick)",
      "Bash(git restore)",
      "Bash(git checkout)",
      "Bash(git branch)",
      "Bash(./autoresearch.sh)",
      "Bash(git checkout -- .)",
      "Bash(git clean -fd)"
    ]
  },
  "model": "opus",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-sensitive-files.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/check-push-main.sh"
          }
        ]
      }
    ],
    "Notification": [],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/autoresearch-context.sh"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "feature-dev@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline-p10k.sh"
  }
}
